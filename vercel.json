{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/vite"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://organisations-ppm-caribbean-silent.trycloudflare.com/api/:match*"
    },
    {
      "source": "/ws",
      "destination": "https://organisations-ppm-caribbean-silent.trycloudflare.com/ws"
    }
  ]
}
